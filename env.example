# The ID of your Notion page (e.g., from the page URL)
NOTION_PAGE_ID=

# Your Notion API integration secret token (optional, if your database is private)
NOTION_ACCESS_TOKEN=

# The URL of your website (used for generating sitemap/SEO)
SITE_URL=

# Vercel Environment (e.g., 'production', 'preview', 'development') - automatically set by Vercel
VERCEL_ENV=
